<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Workes.ConsoleSystem</PackageId>
    <Version>0.5.0</Version>
    <PackageReleaseNotes>Version 0.5.0 continues the ContentSystem-backed rebuild introduced in 0.2.0. It redesigns command values around logical IDs, resolved value maps, bulk defaults, and one optional trailing positional argument, while preserving explicit-source views and binding-specific rules. It also includes command permissions, runtime availability checks, and access-aware autocomplete. ContentSystem remains outside the public API. This is not a drop-in upgrade from the legacy 0.1.0 package.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Workes</Authors>
    <Company>Workes</Company>
    <Product>Workes.ConsoleSystem</Product>
    <Description>An engine-neutral console foundation with manager-centered logging, retained entries, command history, typed synchronous command workflows, stateless autocomplete, optional history change events, and opt-in command permissions and availability checks. Workes.ContentSystem provides internal storage while the public API remains ConsoleSystem-owned.</Description>
    <PackageTags>console command-line logging history game development tools</PackageTags>
    <PackageProjectUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Workes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Workes.ContentSystem" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\docs\*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
