<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Workes.ConsoleSystem</PackageId>
    <Version>0.8.0</Version>
    <PackageReleaseNotes>Version 0.8.0 adds immediate streamed command output, optional per-execution progress state, and transient manager progress notifications with terminal outcomes. It also includes asynchronous command execution, cooperative cancellation, optional host-thread callback dispatch, and synchronized histories. The package continues the ContentSystem-backed rebuild introduced in 0.2.0; ContentSystem remains outside the public API. This pre-1.0 release is not a drop-in upgrade from earlier package versions.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Workes</Authors>
    <Company>Workes</Company>
    <Product>Workes.ConsoleSystem</Product>
    <Description>An engine-neutral console foundation with manager-centered logging, retained entries, command history, typed synchronous and asynchronous command workflows, streamed output, progress reporting, stateless autocomplete, permissions, availability checks, and an opt-in configurable help command. Workes.ContentSystem provides internal storage while the public API remains ConsoleSystem-owned.</Description>
    <PackageTags>console command-line logging history game development tools</PackageTags>
    <PackageProjectUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WorkesLibraries/Workes.ConsoleSystem.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Workes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Workes.ContentSystem" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\docs\*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
